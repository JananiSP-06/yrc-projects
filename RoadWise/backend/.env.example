# Environment variables for the Spring Boot backend. Export them in your shell (or set them in your IDE run configuration).
# Nothing here is read from this file automatically; it only documents the names.
DB_URL=jdbc:mysql://localhost:3306/roadwise?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-to-your-pwd
ADMIN_USERNAME=admin
ADMIN_PASSWORD=add-a-pwd
# Where the React app is served from. Add your deployed address when you go live.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
SEED_ENABLED=true
SERVER_PORT=8080
